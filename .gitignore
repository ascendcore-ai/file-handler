# Binaries and executables
file-handler
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, coverage profiles
*.test
*.out

# Air live reload temporary build folder
tmp/

# Uploads directory contents (preserve directory via .gitkeep)
uploads/*
!uploads/.gitkeep

# Local environment configuration and secrets
.env
.env.local
*.local

