# ==============================================================================
# High-Performance Streaming File Server - Environment Configuration
# ==============================================================================

# Server Settings
PORT=8080
STORAGE_TYPE=local           # Supported: local, s3, gcs, azure
STORAGE_PREFIX=              # Optional prefix/namespace (e.g. tenant-1/ or media/)

# ------------------------------------------------------------------------------
# 1. Local Filesystem Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 2. AWS S3 / S3-Compatible Configuration (MinIO, Cloudflare R2, Wasabi, etc.)
# ------------------------------------------------------------------------------
# AWS_S3_BUCKET=my-app-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Custom S3 Endpoint (Uncomment for MinIO, Cloudflare R2, Wasabi, LocalStack)
# AWS_ENDPOINT_URL=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_USE_SSL=false

# ------------------------------------------------------------------------------
# 3. Google Cloud Storage (GCS) Configuration
# ------------------------------------------------------------------------------
# GCS_BUCKET=my-gcs-bucket
# GCS_ENDPOINT=https://storage.googleapis.com
# GCS_BEARER_TOKEN=ya29.a0AfH6SM...

# ------------------------------------------------------------------------------
# 4. Azure Blob Storage Configuration
# ------------------------------------------------------------------------------
# AZURE_STORAGE_ACCOUNT=mystorageaccount
# AZURE_CONTAINER=mycontainer
# AZURE_SAS_TOKEN=sp=racwdl&st=...
# AZURE_ENDPOINT=https://mystorageaccount.blob.core.windows.net

# ------------------------------------------------------------------------------
# 5. PostgreSQL Metadata ORM Configuration (Optional, Disabled by Default)
# ------------------------------------------------------------------------------
DB_ENABLED=false
DB_DSN=postgresql://postgres:postgres@localhost:5432/file_metadata?sslmode=disable
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=5m

# ------------------------------------------------------------------------------
# 6. Structured Logging Configuration (Kibana, Cloud Logging, CloudWatch, Datadog)
# ------------------------------------------------------------------------------
# LOG_FORMAT: 'text' (human-readable for local dev) or 'json' (structured NDJSON for production)
LOG_FORMAT=text
# LOG_LEVEL: debug, info, warn, error
LOG_LEVEL=info

